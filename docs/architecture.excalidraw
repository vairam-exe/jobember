   "text": "Naukri captcha-gates EVERY token endpoint\n(validRequest:false + captchaSiteKey),\nso a browser-issued token is the only hands-free\nsource — and cookies are IP-bound.",
   "fontSize": 15,
   "fontFamily": 1,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "a7",
   "originalText": "Naukri captcha-gates EVERY token endpoint\n(validRequest:false + captchaSiteKey),\nso a browser-issued token is the only hands-free\nsource — and cookies are IP-bound.",
   "lineHeight": 1.25,
   "autoResize": true
  },
