   "locked": false,
   "text": "Naukri rate-limits hard: FETCH_SLEEP 1.2 s between calls,\n3 s back-off after an error, and a city search that adds nothing\nnew aborts the remaining cities for that keyword.",
   "fontSize": 15,
   "fontFamily": 1,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "f6",
   "originalText": "Naukri rate-limits hard: FETCH_SLEEP 1.2 s between calls,\n3 s back-off after an error, and a city search that adds nothing\nnew aborts the remaining cities for that keyword.",
   "lineHeight": 1.25,
   "autoResize": true
  },
